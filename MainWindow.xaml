<Window x:Class="PentabServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PentabServer"
        mc:Ignorable="d"
        Title="Pentab PC Server" Height="620" Width="880"
        Background="#121214" Foreground="#E0E0E0"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Meiryo UI, sans-serif">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#242429"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3D3D45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#242429"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3D3D45"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="#3A7AFE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1B1B1F" CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Pentab PC Server" FontSize="20" FontWeight="Bold" Foreground="#4A90E2"/>
                    <TextBlock Text="Ultra-low latency Android drawing tablet bridge" FontSize="12" Foreground="#8E8E93" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Status Badge -->
                <Border Grid.Column="1" Background="#242429" CornerRadius="8" Padding="12,6" BorderBrush="#3D3D45" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#FF5252" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="Server Stopped" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Controls & Config -->
            <Border Grid.Column="0" Background="#1B1B1F" CornerRadius="10" Padding="16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Server Configuration" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>

                    <!-- Port Setting -->
                    <TextBlock Text="Port:" FontSize="13" Margin="0,0,0,4"/>
                    <TextBox x:Name="PortTextBox" Text="8765" Margin="0,0,0,12"/>

                    <!-- Monitor Selection -->
                    <TextBlock Text="Target Monitor:" FontSize="13" Margin="0,0,0,4"/>
                    <ComboBox x:Name="MonitorComboBox" Margin="0,0,0,16" SelectionChanged="MonitorComboBox_SelectionChanged"/>

                    <!-- Server Start/Stop Button -->
                    <Button x:Name="ToggleServerButton" Content="Start Server" Style="{StaticResource ModernButton}" Height="38" Click="ToggleServerButton_Click" Margin="0,0,0,16"/>

                    <Separator Background="#2C2C32" Margin="0,0,0,12"/>

                    <!-- USB Connection Guide -->
                    <TextBlock Text="Quick Connect (USB ADB):" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                    <Border Background="#141416" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                        <TextBlock Text="adb reverse tcp:8765 tcp:8765" FontFamily="Consolas, monospace" FontSize="11" Foreground="#4A90E2" TextWrapping="Wrap"/>
                    </Border>
                    <Button Content="Copy ADB Command" Style="{StaticResource ModernButton}" Background="#2C2C32" Height="30" FontSize="12" Click="CopyAdbButton_Click" Margin="0,0,0,12"/>

                    <!-- Local IP Info -->
                    <TextBlock Text="Wi-Fi Local IPs:" FontSize="12" Foreground="#8E8E93" Margin="0,0,0,2"/>
                    <TextBlock x:Name="LocalIpText" Text="Detecting..." FontSize="12" Foreground="#B0B0B5" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Right Panel: Telemetry & Live Monitor -->
            <Border Grid.Column="1" Background="#1B1B1F" CornerRadius="10" Padding="16" Margin="4,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Live Telemetry" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Client Status -->
                        <Border Grid.Row="0" Background="#242429" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Connected Client:" FontSize="13" Foreground="#8E8E93"/>
                                <TextBlock x:Name="ClientIpText" Grid.Column="1" Text="None" FontWeight="SemiBold" Foreground="#4A90E2"/>
                            </Grid>
                        </Border>

                        <!-- Event Rate & Coordinates -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#242429" CornerRadius="8" Padding="12,10" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Event Rate" FontSize="11" Foreground="#8E8E93"/>
                                    <TextBlock x:Name="EventRateText" Text="0 eps" FontSize="18" FontWeight="Bold" Foreground="#00E676" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#242429" CornerRadius="8" Padding="12,10" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Normalized Coords (X, Y)" FontSize="11" Foreground="#8E8E93"/>
                                    <TextBlock x:Name="CoordsText" Text="0.000, 0.000" FontSize="18" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Pressure Bar -->
                        <Border Grid.Row="2" Background="#242429" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Stylus Pressure" FontSize="12" Foreground="#8E8E93"/>
                                    <TextBlock x:Name="PressureValueText" Text="0.0%" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#4A90E2"/>
                                </Grid>
                                <ProgressBar x:Name="PressureBar" Height="10" Minimum="0" Maximum="100" Value="0" Foreground="#4A90E2" Background="#1B1B1F" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <!-- Action & Tool Type Info -->
                        <Border Grid.Row="3" Background="#242429" CornerRadius="8" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Action:" FontSize="11" Foreground="#8E8E93"/>
                                    <TextBlock x:Name="ActionTypeText" Text="IDLE" FontWeight="SemiBold" FontSize="14"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Tool:" FontSize="11" Foreground="#8E8E93"/>
                                    <TextBlock x:Name="ToolTypeText" Text="STYLUS" FontWeight="SemiBold" FontSize="14"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Panel: Activity Log -->
        <Border Grid.Row="2" Background="#1B1B1F" CornerRadius="10" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Activity Log" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" Foreground="#8E8E93"/>
                <TextBox x:Name="LogTextBox" Grid.Row="1" Background="#141416" Foreground="#B0B0B5" BorderThickness="0"
                         IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, monospace" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
